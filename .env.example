# 复制为 .env 后填写。不要提交真实密钥。
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# 可按需覆盖。默认值与当前已验证的 Qwen 配置一致。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# Web UI 使用 HTTP Basic 登录，并且仅通过 SSH 隧道访问。
WEB_USERNAME=examiner
WEB_PASSWORD=replace-with-a-long-random-password
WEB_RATE_LIMIT_MAX=10
WEB_RATE_LIMIT_WINDOW_MS=60000
WEB_MAX_CONCURRENT_AUDITS=1
